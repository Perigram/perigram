{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutkit.dev/schemas/nodi-operation-manifest.schema.json",
  "title": "CutKit Nodi3d Operation Manifest",
  "type": "object",
  "required": ["id", "operation", "version", "graphFile", "inputs", "outputs"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$"
    },
    "graphFile": {
      "type": "string",
      "minLength": 1
    },
    "placementModes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["root", "edge"]
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/socket" }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/socket" }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "socketType": {
      "type": "string",
      "enum": [
        "number",
        "integer",
        "angleDeg",
        "text",
        "json",
        "point2",
        "point2List",
        "curve",
        "closedCurve",
        "edge",
        "edgeList",
        "region",
        "regionList",
        "transform2",
        "layerGeometry",
        "layerGeometryList"
      ]
    },
    "socket": {
      "type": "object",
      "required": ["name", "type", "socket"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        },
        "type": {
          "$ref": "#/$defs/socketType"
        },
        "socket": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "default": {},
        "enum": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "integer" },
              { "type": "boolean" }
            ]
          }
        },
        "optional": {
          "type": "boolean"
        },
        "nodi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "access": {
              "type": "string",
              "enum": ["Item", "List", "Tree"]
            },
            "hint": {
              "type": "string"
            },
            "hintCode": {
              "type": "integer"
            }
          }
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
