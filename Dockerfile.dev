# Development Dockerfile with hot reload
FROM node:24.15.0-slim

# Build proxy settings are supplied by Compose as build args (never ENV).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

# Trust the host's CA bundle for TLS-inspecting development proxies. The
# bundle is a BuildKit secret, never part of the build context or image history.
# Use it for the bootstrap apt request, then install it as the system bundle so
# npm and later build steps trust the same proxy certificate chain.
RUN --mount=type=secret,id=host_ca_bundle,target=/tmp/host-ca-bundle.crt,required=false,mode=0444 \
    if [ -s /tmp/host-ca-bundle.crt ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
      fi && \
      apt-get -o Acquire::https::CAInfo=/tmp/host-ca-bundle.crt update && \
      apt-get -o Acquire::https::CAInfo=/tmp/host-ca-bundle.crt install -y --no-install-recommends ca-certificates curl python3 python3-pip && \
      install -m 0644 /tmp/host-ca-bundle.crt /etc/ssl/certs/ca-certificates.crt; \
    else \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip; \
    fi && \
    rm -rf /var/lib/apt/lists/*
# Node must use the system trust store too (for npm and local tooling).
ENV NODE_USE_SYSTEM_CA=1

WORKDIR /src

# Copy package files
COPY package.json package-lock.json ./

# Install ALL dependencies (including dev dependencies)
RUN npm ci

# Install python dependencies for local scripts (DXF generation)
COPY workers/nesting/requirements.txt /tmp/requirements.txt
# usage of --break-system-packages is necessary in newer debian/python versions or use venv
RUN pip3 install -r /tmp/requirements.txt --break-system-packages

# Copy source code
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
