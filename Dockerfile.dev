# Development Dockerfile with hot reload
FROM node:24.15.0-slim

# Build proxy settings are supplied by Compose as build args (never ENV).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

# The host CA bundle is provided as a BuildKit secret. This preserves TLS
# verification when builds use a TLS-inspecting proxy without baking trust
# material or proxy credentials into image layers.
RUN --mount=type=secret,id=build_ca_bundle,target=/tmp/build-ca-bundle,required=true \
    apt-get update -o Acquire::https::CAInfo=/tmp/build-ca-bundle && \
    apt-get install -y --no-install-recommends ca-certificates curl python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# Let Node use the trusted system CA store for build-time and runtime HTTPS.\nENV NODE_USE_SYSTEM_CA=1\n\nWORKDIR /src

# Copy package files
COPY package.json package-lock.json ./

# Install ALL dependencies (including dev dependencies)
RUN --mount=type=secret,id=build_ca_bundle,target=/tmp/build-ca-bundle,required=true \
    NODE_EXTRA_CA_CERTS=/tmp/build-ca-bundle npm ci

# Install python dependencies for local scripts (DXF generation)
COPY workers/nesting/requirements.txt /tmp/requirements.txt
# usage of --break-system-packages is necessary in newer debian/python versions or use venv
RUN --mount=type=secret,id=build_ca_bundle,target=/tmp/build-ca-bundle,required=true \
    PIP_CERT=/tmp/build-ca-bundle pip3 install -r /tmp/requirements.txt --break-system-packages

# Copy source code
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
