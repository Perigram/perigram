{
  "pluginId": "coatings",
  "name": "Coatings",
  "description": "Coating reference type and matching service (demo plugin)",
  "version": "1",
  "declarations": {
    "types": [
      {
        "id": "coating",
        "class": "item",
        "name": "Coating",
        "fields": {
          "code": { "base": "string", "identifier": true },
          "gloss": { "base": "enum", "values": ["matte", "satin", "gloss"] }
        }
      }
    ],
    "services": [
      {
        "id": "match",
        "label": "Coating match",
        "mode": "endpoint",
        "signature": {
          "input": { "base": "record", "fields": { "code": { "base": "string" }, "gloss": { "base": "string" } } },
          "output": { "base": "json" }
        }
      }
    ]
  }
}
