{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "~~/*": ["./*"],
      "~/*": ["./*"],
      "@@/*": ["./*"],
      "@/*": ["./*"],
      "~~/server/*": ["./server/*"],
      "@perigram/core": ["./packages/core/src/index.js"],
      "@perigram/workflows": ["./packages/workflows/src/index.js"],
      "@perigram/mongo": ["./packages/mongo/src/index.js"],
      "@perigram/nitro": ["./packages/nitro/src/index.js"],
      "@perigram/vue": ["./packages/vue/src/index.js"],
      "@perigram/devtools": ["./packages/devtools/src/index.js"],
      "@perigram/mcp": ["./packages/mcp/src/index.js"],
      "@perigram/domain-cnc": ["./packages/domain-cnc/src/index.js"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    ".nuxt/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output"
  ]
}
