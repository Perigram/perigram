{
  "name": "perigram-demo",
  "private": false,
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*",
    "#packages/*": "./packages/*",
    "#utils/*": "./utils/*",
    "#test-data/*": "./test-data/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "framework:list-entities": "node scripts/framework-inspect.js list-entities",
    "framework:list-workflows": "node scripts/framework-inspect.js list-workflows",
    "framework:list-routes": "node scripts/framework-inspect.js list-routes",
    "framework:list-commands": "node scripts/framework-inspect.js list-commands",
    "framework:list-ui-primitives": "node scripts/framework-inspect.js list-ui-primitives",
    "framework:manifest": "node scripts/framework-inspect.js check-manifest",
    "framework:write-manifest": "node scripts/framework-inspect.js write-manifest",
    "framework:validate": "node scripts/framework-inspect.js validate",
    "agent:scope-check": "node scripts/check-agent-scope.js",
    "design:scope-check": "node scripts/check-agent-scope.js --allow .agents/design-layer.allowlist",
    "icons:build": "node scripts/build-icon-fonts.js",
    "test:durable": "node --test server/features/process-definitions/run-repository.spec.js",
    "docs:validate": "node scripts/check-docs.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/plugin-slash": "^7.22.3",
    "@napi-rs/canvas": "^0.1.100",
    "@nuxtjs/i18n": "^10.1.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^2.0.3",
    "@vue-flow/core": "^1.48.2",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "dxf-parser": "^1.1.2",
    "formidable": "^3.5.4",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "livekit-client": "^2.22.3",
    "marked": "^12.0.2",
    "mongodb": "6.8",
    "multiparty": "^4.2.3",
    "nodemailer": "^7.0.3",
    "nuxt": "^3.15.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "pdfkit": "^0.17.2",
    "perfect-freehand": "^1.2.3",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "standard-slugify": "^4.0.0",
    "tabulator-tables": "^6.3.1",
    "tslib": "^2.8.1",
    "vite": "^6.0.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@primevue/nuxt-module": "^4.5.5",
    "@types/node": "^22.10.2",
    "fantasticon": "^4.1.0",
    "kickstart-scripts": "^1.0.1",
    "module-alias": "^2.3.4",
    "mongodb-memory-server": "^10.1.2",
    "patch-package": "^8.0.0",
    "prettier": "3.5.3",
    "sass": "1.77.6",
    "sass-loader": "^16.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
