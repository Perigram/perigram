{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perigram.dev/schemas/plugin-listing.schema.json",
  "title": "Perigram plugin listing",
  "description": "A platform-published plugin catalog listing: declarations (types, services, editors, attachment kinds, conversions) plus pack requirements. The authoritative validator is parseListing in @perigram/plugin-sdk; this schema mirrors it for editors, agents, and tooling.",
  "type": "object",
  "required": ["pluginId", "name", "declarations"],
  "additionalProperties": true,
  "properties": {
    "pluginId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": ["string", "number"] },
    "requires": {
      "type": "array",
      "description": "Mounted pack ids the plugin's types resolve against",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "declarations": {
      "type": "object",
      "required": ["types"],
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "class"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "class": { "enum": ["file", "item", "group"] },
              "name": { "type": "string" }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "signature"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "label": { "type": "string" },
              "mode": { "enum": ["endpoint", "claim"] },
              "render": { "type": "object" },
              "signature": {
                "type": "object",
                "required": ["input", "output"],
                "additionalProperties": true,
                "properties": {
                  "input": { "type": "object" },
                  "output": { "type": "object" }
                }
              }
            }
          }
        },
        "editors": {
          "type": "array",
          "description": "File-type editor bindings; the bound type must be declared by this plugin and carry the file class",
          "items": {
            "type": "object",
            "required": ["type", "surface", "modes"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "surface": { "type": "string", "minLength": 1 },
              "modes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "surfaces": {
          "type": "array",
          "description": "Plugin-delivered editor surface modules (owner decision 2026-10-11): the executor serves each module; surfaceContract is the mount-contract major it targets",
          "items": {
            "type": "object",
            "required": ["id", "module", "surfaceContract"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "module": {
                "type": "string",
                "pattern": "^/[a-z0-9/_-]+\\.m?js$",
                "description": "Root-relative module path the plugin's executor serves"
              },
              "surfaceContract": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "attachmentKinds": {
          "type": "object",
          "description": "Payload upload contracts keyed by kind id (the pack vocabulary)",
          "additionalProperties": { "type": "object" }
        },
        "conversions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sourceKinds", "target"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "sourceKinds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "target": { "type": "object" },
              "service": {
                "type": "string",
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
                "description": "The plugin service that executes the conversion: a bare service id of this plugin, or a plugin-qualified id"
              }
            }
          }
        },
        "constructions": {
          "type": "object",
          "description": "Construction modes of the plugin's own types bound to plugin services: typeId -> mode -> plugin-qualified service ref",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
            "additionalProperties": { "type": "string", "pattern": "^plugin\\.[a-z0-9-]+\\.[a-z0-9-]+$" }
          }
        },
        "exports": {
          "type": "array",
          "description": "Attachment exports bound to plugin services",
          "items": {
            "type": "object",
            "required": ["typeId", "kind", "service"],
            "additionalProperties": true,
            "properties": {
              "typeId": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "service": { "type": "string", "pattern": "^plugin\\.[a-z0-9-]+\\.[a-z0-9-]+$" },
              "extension": { "type": "string" },
              "mime": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
