{
  "pluginId": "geometry-base",
  "name": "Geometry Base",
  "description": "Canonical geometry kinds, coordinate conventions, and basic point, vector, plane, and frame operations",
  "version": "1",
  "declarations": {
    "types": [],
    "runtimes": [
      {
        "id": "geometry-base",
        "language": "javascript",
        "version": "1",
        "entry": "/runtime/geometry-base-bundle.mjs",
        "targets": ["browser", "server"]
      }
    ],
    "services": [
      {
        "id": "make-point3",
        "label": "Point",
        "description": "Construct a point from x, y, z coordinates",
        "signature": {
          "input": {
            "base": "record",
            "fields": {
              "x": { "base": "number", "nullable": true, "default": 0 },
              "y": { "base": "number", "nullable": true, "default": 0 },
              "z": { "base": "number", "nullable": true, "default": 0 }
            }
          },
          "output": { "base": "json", "kind": "geometry.point3", "unit": "mm" }
        },
        "execution": {
          "runtime": "geometry-base",
          "kind": "pure",
          "targets": ["browser", "server"],
          "capabilities": [],
          "deterministic": true,
          "idempotent": true
        },
        "palette": { "group": "points-vectors", "label": "Points & vectors" }
      },
      {
        "id": "make-vector3",
        "label": "Vector",
        "description": "Construct a vector from x, y, z components",
        "signature": {
