{
  "pluginId": "documents",
  "name": "Documents",
  "description": "The generic media/office file types (images, PDF, markdown, HTML, CSV, XLSX, DOCX) with their editor surfaces, table projections, template fills, and CSV composition as an installable plugin",
  "version": "33",
  "requires": [
    "tech-drawing"
  ],
  "declarations": {
    "types": [
      {
        "id": "image",
        "class": "file",
        "scope": "system",
        "name": "Image",
        "glyph": "ck-file-type-icon ck-file-type-icon-image",
        "payload": {
          "mime": [
            "image/jpeg",
            "image/png"
          ],
          "accept": [
            ".jpg",
            ".jpeg",
            ".png",
            "image/jpeg",
            "image/png"
          ],
          "maxSize": 26214400,
          "preview": "image",
          "creation": [
            "upload",
            "capture"
          ]
        },
        "revisions": "content",
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          }
        }
      },
      {
        "id": "pdf-document",
        "class": "file",
        "scope": "system",
        "name": "PDF document",
        "glyph": "ck-file-type-icon ck-file-type-icon-pdf-document",
        "payload": {
          "mime": [
            "application/pdf"
          ],
          "accept": [
            ".pdf",
            "application/pdf"
          ],
          "maxSize": 26214400,
          "preview": "pdf"
        },
        "revisions": "content",
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          }
        },
        "operators": {
          "fill": {
            "id": "fill",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "template": {
                  "base": "ref",
                  "accepts": [
                    "pdf-document"
                  ],
                  "label": "Template"
                },
                "values": {
                  "base": "json",
                  "nullable": true,
                  "label": "Values",
                  "control": "template-values"
                }
              }
            }
          },
          "render": {
            "id": "render",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "source": {
                  "base": "ref",
                  "accepts": [
                    "text-document",
                    "csv-table",
                    "xlsx-workbook",
                    "image",
                    "dxf-source"
                  ],
                  "label": "Source"
                }
              }
            }
          }
        }
      },
      {
        "id": "text-document",
        "class": "file",
        "scope": "system",
        "name": "Text document",
        "glyph": "ck-file-type-icon ck-file-type-icon-text-document",
        "payload": {
          "mime": [
            "text/markdown"
          ],
          "accept": [
            ".md",
            "text/markdown"
          ],
          "maxSize": 10485760,
          "preview": "text",
          "creation": [
            "editor",
            "content",
            "upload"
          ]
        },
        "revisions": "content",
        "projections": [
          {
            "id": "text",
            "label": "Text",
            "output": {
              "base": "string"
            },
            "resolve": {
              "service": "plugin.documents.text"
            },
            "palette": {
              "group": "document-sources",
              "label": "Document sources"
            }
          }
        ],
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          }
        },
        "operators": {
          "fill": {
            "id": "fill",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "template": {
                  "base": "ref",
                  "accepts": [
                    "text-document"
                  ],
                  "label": "Template"
                },
                "values": {
                  "base": "json",
                  "nullable": true,
                  "label": "Values",
                  "control": "template-values"
                }
              }
            }
          }
        }
      },
      {
        "id": "html-document",
        "class": "file",
        "scope": "system",
        "name": "HTML document",
        "glyph": "pi pi-code",
        "payload": {
          "mime": [
            "text/html"
          ],
          "accept": [
            ".html",
            ".htm",
            "text/html"
          ],
          "maxSize": 10485760,
          "preview": "download",
          "creation": [
            "upload"
          ]
        },
        "revisions": "content",
        "projections": [
          {
            "id": "text",
