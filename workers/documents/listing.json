              "service": "plugin.documents.table-rows"
            },
            "palette": {
              "group": "table-data",
              "label": "Table data"
            }
          },
          {
            "id": "cells",
            "label": "Table cells (positional)",
            "output": {
              "base": "list",
              "itemType": {
                "base": "record"
              }
            },
            "resolve": {
              "service": "plugin.documents.table-cells"
            },
            "palette": {
              "group": "table-data",
              "label": "Table data"
            }
          }
        ],
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          }
        }
