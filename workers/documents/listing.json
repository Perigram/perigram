    "services": [
      {
        "id": "table-rows",
        "label": "Table rows",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "record",
            "fields": {
              "payload": {
                "base": "blob"
              }
            }
          },
          "output": {
            "base": "list",
            "itemType": {
              "base": "record"
            }
          }
        },
        "cache": "deterministic",
        "render": {
          "label": "Table rows",
          "icon": "pi pi-table"
        },
        "description": "Read the first worksheet as records keyed by its header row",
        "palette": {
          "group": "table-data",
          "label": "Table data",
          "visible": false
        }
      },
      {
        "id": "table-cells",
        "label": "Table cells (positional)",
