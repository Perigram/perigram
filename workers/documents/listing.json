        "execution": {
          "runtime": "documents-shared",
          "kind": "pure",
          "targets": [
            "browser",
            "server"
          ],
          "capabilities": [],
          "idempotent": true,
          "deterministic": true
        },
        "palette": {
          "group": "table-data",
          "label": "Table data"
