{
  "pluginId": "build123d",
  "name": "build123d",
  "description": "Parametric B-Rep CAD operations discovered from the installed build123d 0.13.0 API: shape constructors, part/sketch operations, and the shape-algebra operators, as deterministic value services",
  "version": "1",
  "declarations": {
    "types": [
      {
        "id": "b3d-part",
        "class": "file",
        "scope": "system",
        "name": "Part",
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          }
        },
        "payload": {
          "mime": [
            "application/step",
            "model/step"
          ],
          "accept": [
            ".step",
            ".stp",
            "application/step"
          ],
          "maxSize": 52428800,
          "preview": "none",
          "creation": [
            "upload"
          ]
        },
        "revisions": "content"
      }
    ],
    "services": [
