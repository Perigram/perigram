{
  "pluginId": "facade",
  "name": "Facade fabrication",
  "description": "Cassette templates, cassette designs, cassette instances, sheet designs, sheet cut plans, sheet instances, and the nesting solver as an installable plugin with an external executor",
  "version": "43",
  "requires": [
    "tech-drawing"
  ],
  "declarations": {
    "types": [
      {
        "id": "cassette-template",
        "class": "file",
        "scope": "system",
        "version": 1,
        "renameFrom": "cassette",
        "payload": {
          "mime": "application/perigram+occs",
          "accept": [
            ".occs"
          ],
          "maxSize": 10485760,
          "creation": [
            "editor"
          ]
        },
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "mapping": {
            "base": "json",
            "constructible": false
          },
          "polygonParts": {
            "base": "json",
            "constructible": false
          },
          "layerData": {
            "base": "json",
            "constructible": false
          }
        },
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.polygonParts",
                  "fallbackPaths": [
                    "fields.layerData"
                  ],
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 20
                }
              ]
            }
          ]
        },
        "snapshot": [
          "fields.mapping",
          "fields.polygonParts",
          "fields.layerData"
        ],
        "operators": {
          "edit": {
            "id": "edit",
            "species": "mutate",
            "input": {
              "base": "ref",
              "accepts": [
                "cassette-template"
              ]
            }
          }
        },
        "name": "Cassette template",
        "glyph": "ck-entity-icon ck-entity-icon-cassette-template"
      },
      {
        "id": "cassette-design",
        "class": "file",
        "scope": "system",
        "version": 3,
        "payload": {
          "mime": [
            "application/dxf",
            "image/vnd.dxf"
          ],
          "accept": [
            ".dxf",
            "application/dxf",
            "image/vnd.dxf"
          ],
          "maxSize": 26214400,
          "preview": "dxf",
          "creation": [
            "upload"
          ],
          "inputs": {
            "mapping": {
              "base": "json",
              "label": "Layer mapping",
              "control": "layer-mapping",
              "controlOptions": {
                "requiredTarget": "cut.outer",
                "targets": [
                  "cut.outer",
                  "cut.inner",
                  "cut.hole",
                  "fold.route",
                  "fold.engrave",
                  "contour.cassette_face",
                  "code.cassette_mark",
                  "dimension.cassette"
                ]
              }
            }
          }
        },
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.geometry.layerData",
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 10
                }
              ]
            }
          ]
        },
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "template": {
            "base": "ref",
            "accepts": [
              "cassette-template"
            ],
            "slot": "data",
            "nullable": true,
            "constructible": false
          },
          "source": {
            "base": "ref",
            "accepts": [
              "dxf-source"
            ],
            "slot": "data",
            "nullable": true,
            "constructible": false
          },
          "parameters": {
            "base": "json"
          },
          "mapping": {
            "base": "json",
            "nullable": true,
            "constructible": false
          },
          "geometry": {
            "base": "json",
            "constructible": false
          }
        },
        "name": "Cassette design",
        "glyph": "ck-entity-icon ck-entity-icon-cassette-design",
        "migrate": [
          {
            "kind": "retype-field",
            "field": "template",
            "via": {
              "op": "field",
              "path": [
                "value"
              ]
            }
          }
        ],
        "snapshot": [
          "fields.template",
          "fields.parameters"
        ],
        "operators": {
          "render": {
            "id": "render",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "template": {
                  "base": "ref",
                  "accepts": [
                    "cassette-template"
                  ]
                },
                "parameters": {
                  "base": "json",
                  "nullable": true,
                  "control": "cassette-parameters",
                  "controlOptions": {
                    "templateField": "template"
                  }
                }
              }
            }
          },
          "convertDxf": {
            "id": "convertDxf",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "source": {
                  "base": "ref",
                  "accepts": [
                    "dxf-source"
                  ]
                }
              }
            }
          }
        },
        "projections": [
          {
            "id": "nesting-polygons",
            "label": "Nesting parts",
            "group": "facade",
            "output": {
              "base": "record",
              "fields": {
                "designId": {
                  "base": "id"
                },
                "polygonParts": {
                  "base": "list",
                  "itemType": {
                    "base": "json"
                  }
                }
              }
            },
            "resolve": {
              "service": "plugin.facade.nesting-parts"
            }
          }
        ]
      },
      {
        "id": "cassette-instance",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true,
            "nullable": true
          },
          "design": {
            "base": "ref",
            "accepts": [
              "cassette-design"
            ],
            "nullable": true
          }
        },
        "name": "Cassette",
        "glyph": "ck-entity-icon ck-entity-icon-cassette-instance"
      },
      {
        "id": "sheet-design",
        "class": "file",
        "scope": "system",
        "version": 8,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true,
            "nullable": true
          },
          "compositionKey": {
            "base": "string",
            "nullable": true
          },
          "geometry": {
            "base": "json"
          }
        },
        "edges": {
          "relations": {
            "parts": {
              "types": [
                "cassette-design"
              ],
              "onRemove": "detach",
              "cardinality": "many"
            },
            "dxf": {
              "types": [
                "sheet-dxf"
              ],
              "onRemove": "detach",
              "cardinality": "one"
            }
          }
        },
        "migrate": [
          {
            "kind": "rename-field",
            "from": "title",
            "to": "name"
          },
          {
            "kind": "remove-field",
            "field": "parts"
          }
        ],
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.geometry.preview",
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 10
                }
              ]
            }
          ]
        },
        "operators": {
          "fromLayout": {
            "id": "fromLayout",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "layout": {
                  "base": "json",
                  "nullable": true
                },
                "designs": {
                  "base": "list",
                  "itemType": {
                    "base": "ref",
                    "accepts": [
                      "cassette-design"
                    ]
                  },
                  "nullable": true
                }
              }
            }
          }
        },
        "name": "Sheet design",
        "glyph": "ck-entity-icon ck-entity-icon-sheet-design"
      },
      {
        "id": "sheet-dxf",
        "class": "file",
        "scope": "system",
        "version": 1,
        "payload": {
          "mime": "application/dxf",
          "accept": [
            ".dxf"
          ],
          "maxSize": 26214400,
          "preview": "dxf"
        },
        "fields": {
          "name": {
            "base": "string",
            "identifier": true,
            "nullable": true
          },
          "sheet": {
            "base": "ref",
            "accepts": [
              "sheet-design"
            ],
            "slot": "data",
            "nullable": true
          }
        },
        "operators": {
          "fromSheet": {
            "id": "fromSheet",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "sheet": {
                  "base": "ref",
                  "accepts": [
                    "sheet-design"
                  ]
                }
              }
            }
          }
        },
        "name": "Sheet DXF",
        "glyph": "pi pi-file-export"
      },
      {
        "id": "sheet-cut-plan",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true,
            "nullable": true
          },
          "design": {
            "base": "ref",
            "accepts": [
              "sheet-design"
            ]
          },
          "sheet": {
            "base": "ref",
            "accepts": [
              "sheet-instance"
            ],
            "nullable": true
          }
        },
        "name": "Sheet cut plan",
        "glyph": "pi pi-file-export"
      },
      {
        "id": "sheet-instance",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true,
            "nullable": true
          }
        },
        "name": "Sheet",
        "glyph": "ck-entity-icon ck-entity-icon-sheet-instance"
      },
      {
        "id": "profile",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "kind": {
            "base": "string"
          },
          "process": {
            "base": "string"
          },
          "sketch": {
            "base": "json",
            "constructible": false
          }
        },
        "access": {
          "inherits": "cassette-template"
        },
        "name": "Profile",
        "glyph": "pi pi-wave-pulse"
      },
      {
        "id": "hardware",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "family": {
            "base": "string"
          },
          "productionMode": {
            "base": "string"
          },
          "parameters": {
            "base": "json",
            "constructible": false
          }
        },
        "access": {
          "inherits": "cassette-template"
        },
        "name": "Hardware",
        "glyph": "ck-entity-icon ck-entity-icon-bolt"
      }
    ],
    "services": [
      {
        "id": "nesting-solve",
        "label": "Solve sheet nesting",
        "group": "nesting",
        "render": {
          "label": "Nesting solver",
          "icon": "pi pi-compass"
        },
        "signature": {
          "input": {
            "base": "record",
            "fields": {
              "items": {
                "base": "list",
                "itemType": {
                  "base": "record",
                  "fields": {
                    "designId": {
                      "base": "id",
                      "nullable": true
                    },
                    "designKey": {
                      "base": "string",
                      "nullable": true
                    },
                    "polygonParts": {
                      "base": "list",
                      "itemType": {
                        "base": "record",
                        "fields": {
                          "coordinates": {
                            "base": "list",
                            "itemType": {
                              "base": "record",
                              "fields": {
                                "x": {
                                  "base": "quantity",
                                  "unit": "mm"
                                },
                                "y": {
                                  "base": "quantity",
                                  "unit": "mm"
                                }
                              }
                            }
                          },
                          "sourceLayers": {
                            "base": "list",
                            "nullable": true,
                            "itemType": {
                              "base": "json"
                            }
                          }
                        }
                      }
                    },
                    "count": {
                      "base": "quantity",
                      "unit": "count"
                    }
                  }
                }
              },
              "sheetWidth": {
                "base": "quantity",
                "unit": "mm",
                "default": 1220
              },
              "sheetHeight": {
                "base": "quantity",
                "unit": "mm",
                "default": 2440
              },
              "space": {
                "base": "quantity",
                "unit": "mm",
                "nullable": true
              }
            }
          },
          "output": {
            "base": "json"
          }
        },
        "description": "Arrange cassette-design parts on available sheet stock",
        "execution": {
          "runtime": "facade-server",
          "kind": "read",
          "targets": [
            "server"
          ],
          "capabilities": [
            "facade.nesting.solve"
          ],
          "idempotent": true
        }
      },
      {
        "id": "extract-geometry",
        "label": "Extract cassette-design geometry",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "bake",
        "label": "Bake cassette design",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "generate-sheet-dxf",
        "label": "Export sheet DXF",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        },
        "group": "production-export",
        "description": "Generate a production-layer DXF from a sheet design"
      },
      {
        "id": "construct-sheet",
        "label": "Create sheet design",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        },
        "group": "sheet-planning",
        "description": "Create a sheet design from a solved nesting layout"
      },
      {
        "id": "match-sheet",
        "label": "Find reusable sheet design",
        "mode": "endpoint",
        "group": "sheet-planning",
        "signature": {
          "input": {
            "base": "record",
            "fields": {
              "layoutKey": {
                "base": "string",
                "nullable": true
              },
              "sheets": {
                "base": "list",
                "nullable": true,
                "itemType": {
                  "base": "ref",
                  "accepts": [
                    "sheet-design"
                  ]
                }
              }
            }
          },
          "output": {
            "base": "json"
          }
        },
        "description": "Reuse an existing sheet design with the same composition"
      },
      {
        "id": "nesting-parts",
        "label": "Nesting parts projection",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      }
    ],
    "editors": [
      {
        "type": "cassette-template",
        "surface": "cassette-designer",
        "modes": [
          "create",
          "edit"
        ]
      },
      {
        "type": "sheet-design",
        "surface": "sheet-design-editor",
        "modes": [
          "edit"
        ]
      }
    ],
    "surfaces": [
      {
        "id": "sheet-design-editor",
        "module": "/surfaces/sheet-design-editor.mjs",
        "surfaceContract": 4
      },
      {
        "id": "cassette-designer",
        "module": "/surfaces/cassette-designer.mjs",
        "surfaceContract": 2
      },
      {
        "id": "cassette-preview",
        "module": "/surfaces/cassette-preview.mjs",
        "surfaceContract": 1,
        "kind": "preview"
      },
      {
        "id": "profile-preview",
        "module": "/surfaces/profile-preview.mjs",
        "surfaceContract": 1,
        "kind": "preview"
      }
    ],
    "constructions": {
      "cassette-design": {
        "upload": "plugin.facade.extract-geometry",
        "render": "plugin.facade.bake",
        "convertDxf": "plugin.facade.extract-geometry"
      },
      "sheet-design": {
        "fromLayout": "plugin.facade.construct-sheet"
      },
      "sheet-dxf": {
        "fromSheet": "plugin.facade.generate-sheet-dxf"
      }
    },
    "exports": [
      {
        "typeId": "sheet-design",
        "kind": "dxf",
        "service": "plugin.facade.generate-sheet-dxf"
      }
    ],
    "previews": [
      {
        "type": "cassette-template",
        "surface": "cassette-preview"
      },
      {
        "type": "cassette-design",
        "surface": "cassette-preview"
      },
      {
        "type": "profile",
        "surface": "profile-preview"
      }
    ],
    "dependencies": [
      {
        "name": "cadcraft",
        "version": "0.7.0",
        "module": "plugin:tech-drawing/assets/vendor/cadcraft/host.mjs",
        "license": "Apache-2.0"
      }
    ],
    "runtimes": [
      {
        "id": "facade-server",
        "language": "javascript",
        "version": "1",
        "entry": "/runtime/server.mjs",
        "targets": [
          "server"
        ]
      }
    ]
  }
}
