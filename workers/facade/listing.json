{
  "pluginId": "facade",
  "name": "Facade fabrication",
  "description": "Cassettes, cassette designs, sheet designs, and the nesting solver as an installable plugin with an external executor",
  "version": "20",
  "requires": [
    "tech-drawing"
  ],
  "declarations": {
    "types": [
      {
        "id": "cassette",
        "class": "file",
        "scope": "system",
        "version": 2,
        "payload": {
          "mime": "application/perigram+occs",
          "accept": [
            ".occs"
          ],
          "maxSize": 10485760,
          "creation": [
            "editor"
          ]
        },
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "mapping": {
            "base": "json",
            "constructible": false
          },
          "polygonParts": {
            "base": "json",
            "constructible": false
          },
          "layerData": {
            "base": "json",
            "constructible": false
          }
        },
        "states": {
          "main": {
            "initial": "ACTIVE",
            "states": {
              "ACTIVE": {},
              "ARCHIVED": {
                "terminal": true
              }
            }
          }
        },
        "transitions": [
          {
            "axis": "main",
            "from": "ACTIVE",
            "to": "ARCHIVED",
            "intent": "archiveCassette"
          }
        ],
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.polygonParts",
                  "fallbackPaths": [
                    "fields.layerData"
                  ],
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 20
                }
              ]
            }
          ]
        },
        "snapshot": [
          "fields.mapping",
          "fields.polygonParts",
          "fields.layerData"
        ],
        "operators": {
          "edit": {
            "id": "edit",
            "species": "mutate",
            "input": {
              "base": "ref",
              "accepts": [
                "cassette"
              ]
            }
          }
        },
        "migrate": [
          {
            "kind": "remove-field",
            "field": "templateType"
          },
          {
            "kind": "remove-field",
            "field": "parameters"
          }
        ],
        "name": "Cassette",
        "glyph": "ck-entity-icon ck-entity-icon-cassette-template"
      },
      {
        "id": "cassette-design",
        "class": "file",
        "scope": "system",
        "version": 1,
        "payload": {
          "mime": [
            "application/dxf",
            "image/vnd.dxf"
          ],
          "accept": [
            ".dxf",
            "application/dxf",
            "image/vnd.dxf"
          ],
          "maxSize": 26214400,
          "preview": "dxf",
          "creation": [
            "upload"
          ]
        },
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.geometry.layerData",
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 10
                }
              ]
            }
          ]
        },
        "fields": {
          "name": {
            "base": "string"
          },
          "template": {
            "base": "ref",
            "accepts": [
              "cassette"
            ],
            "slot": "data"
          },
          "source": {
            "base": "ref",
            "accepts": [
              "dxf-source"
            ],
            "slot": "data"
          },
          "parameters": {
            "base": "json"
          },
          "geometry": {
            "base": "json",
            "constructible": false
          }
        },
        "states": {
          "main": {
            "initial": "ACTIVE",
            "states": {
              "ACTIVE": {},
              "ARCHIVED": {
                "terminal": true
              }
            }
          }
        },
        "transitions": [
          {
            "axis": "main",
            "from": "ACTIVE",
            "to": "ARCHIVED",
            "intent": "archiveCassetteDesign"
          }
        ],
        "name": "Cassette design",
        "glyph": "ck-entity-icon ck-entity-icon-cassette-design",
        "snapshot": [
          "fields.template",
          "fields.parameters"
        ],
        "operators": {
          "render": {
            "id": "render",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "template": {
                  "base": "ref",
                  "accepts": [
                    "cassette"
                  ]
                },
                "parameters": {
                  "base": "json",
                  "nullable": true
                }
              }
            }
          },
          "convertDxf": {
            "id": "convertDxf",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "source": {
                  "base": "ref",
                  "accepts": [
                    "dxf-source"
                  ]
                }
              }
            }
          }
        },
        "projections": [
          {
            "id": "nesting-polygons",
            "label": "Nesting parts",
            "group": "facade",
            "output": {
              "base": "list",
              "itemType": {
                "base": "record",
                "fields": {
                  "coordinates": {
                    "base": "list",
                    "itemType": {
                      "base": "record",
                      "fields": {
                        "x": {
                          "base": "quantity",
                          "unit": "mm"
                        },
                        "y": {
                          "base": "quantity",
                          "unit": "mm"
                        }
                      }
                    }
                  },
                  "sourceLayers": {
                    "base": "list",
                    "nullable": true,
                    "itemType": {
                      "base": "json"
                    }
                  }
                }
              }
            },
            "resolve": {
              "service": "plugin.facade.nesting-parts"
            }
          }
        ]
      },
      {
        "id": "sheet-design",
        "class": "file",
        "scope": "system",
        "version": 1,
        "fields": {
          "title": {
            "base": "string",
            "identifier": true,
            "nullable": true,
            "label": "Title"
          },
          "geometry": {
            "base": "json"
          },
          "parts": {
            "base": "list",
            "itemType": {
              "base": "ref",
              "accepts": [
                "cassette"
              ]
            },
            "nullable": true
          }
        },
        "revisions": "geometry",
        "render": {
          "groups": [
            {
              "id": "geometry",
              "fields": [
                {
                  "path": "fields.geometry.preview",
                  "label": "common.details",
                  "role": "previewSource",
                  "display": "geometry",
                  "priority": 10
                }
              ]
            }
          ]
        },
        "operators": {
          "fromLayout": {
            "id": "fromLayout",
            "species": "construct",
            "input": {
              "base": "record",
              "fields": {
                "name": {
                  "base": "string",
                  "nullable": true
                },
                "layout": {
                  "base": "json"
                }
              }
            }
          }
        },
        "name": "Sheet design",
        "glyph": "ck-entity-icon ck-entity-icon-sheet-design"
      },
      {
        "id": "profile",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "kind": {
            "base": "string"
          },
          "process": {
            "base": "string"
          },
          "sketch": {
            "base": "json",
            "constructible": false
          }
        },
        "access": {
          "inherits": "cassette"
        },
        "name": "Profile",
        "glyph": "pi pi-wave-pulse"
      },
      {
        "id": "hardware",
        "class": "item",
        "scope": "system",
        "version": 1,
        "fields": {
          "name": {
            "base": "string",
            "identifier": true
          },
          "family": {
            "base": "string"
          },
          "productionMode": {
            "base": "string"
          },
          "parameters": {
            "base": "json",
            "constructible": false
          }
        },
        "access": {
          "inherits": "cassette"
        },
        "name": "Hardware",
        "glyph": "ck-entity-icon ck-entity-icon-bolt"
      }
    ],
    "services": [
      {
        "id": "nesting-solve",
        "label": "Nesting solver",
        "mode": "endpoint",
        "group": "facade",
        "render": {
          "label": "Nesting solver",
          "icon": "pi pi-compass"
        },
        "signature": {
          "input": {
            "base": "record",
            "fields": {
              "items": {
                "base": "list",
                "itemType": {
                  "base": "record",
                  "fields": {
                    "cassetteId": {
                      "base": "id",
                      "nullable": true
                    },
                    "polygonParts": {
                      "base": "list",
                      "itemType": {
                        "base": "record",
                        "fields": {
                          "coordinates": {
                            "base": "list",
                            "itemType": {
                              "base": "record",
                              "fields": {
                                "x": {
                                  "base": "quantity",
                                  "unit": "mm"
                                },
                                "y": {
                                  "base": "quantity",
                                  "unit": "mm"
                                }
                              }
                            }
                          },
                          "sourceLayers": {
                            "base": "list",
                            "nullable": true,
                            "itemType": {
                              "base": "json"
                            }
                          }
                        }
                      }
                    },
                    "count": {
                      "base": "quantity",
                      "unit": "count"
                    }
                  }
                }
              },
              "sheetWidth": {
                "base": "quantity",
                "unit": "mm",
                "default": 1220
              },
              "sheetHeight": {
                "base": "quantity",
                "unit": "mm",
                "default": 2440
              },
              "space": {
                "base": "quantity",
                "unit": "mm",
                "nullable": true
              },
              "sheetCount": {
                "base": "quantity",
                "unit": "count",
                "nullable": true
              }
            }
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "extract-geometry",
        "label": "Extract cassette-design geometry",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "bake",
        "label": "Bake cassette design",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "generate-sheet-dxf",
        "label": "Generate sheet-design DXF",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "construct-sheet",
        "label": "Construct sheet design",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      },
      {
        "id": "nesting-parts",
        "label": "Nesting parts projection",
        "mode": "endpoint",
        "signature": {
          "input": {
            "base": "json"
          },
          "output": {
            "base": "json"
          }
        }
      }
    ],
    "editors": [
      {
        "type": "cassette",
        "surface": "cassette-designer",
        "modes": [
          "create",
          "edit"
        ]
      },
      {
        "type": "sheet-design",
        "surface": "sheet-design-editor",
        "modes": [
          "edit"
        ]
      }
    ],
    "surfaces": [
      {
        "id": "sheet-design-editor",
        "module": "/surfaces/sheet-design-editor.mjs",
        "surfaceContract": 4
      },
      {
        "id": "cassette-designer",
        "module": "/surfaces/cassette-designer.mjs",
        "surfaceContract": 2
      },
      {
        "id": "cassette-preview",
        "module": "/surfaces/cassette-preview.mjs",
        "surfaceContract": 1,
        "kind": "preview"
      },
      {
        "id": "profile-preview",
        "module": "/surfaces/profile-preview.mjs",
        "surfaceContract": 1,
        "kind": "preview"
      }
    ],
    "constructions": {
      "cassette-design": {
        "upload": "plugin.facade.extract-geometry",
        "render": "plugin.facade.bake",
        "convertDxf": "plugin.facade.extract-geometry"
      },
      "sheet-design": {
        "fromLayout": "plugin.facade.construct-sheet"
      }
    },
    "exports": [
      {
        "typeId": "sheet-design",
        "kind": "dxf",
        "service": "plugin.facade.generate-sheet-dxf"
      }
    ],
    "previews": [
      {
        "type": "cassette",
        "surface": "cassette-preview"
      },
      {
        "type": "cassette-design",
        "surface": "cassette-preview"
      },
      {
        "type": "profile",
        "surface": "profile-preview"
      }
    ]
  }
}
