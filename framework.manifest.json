  "workflows": [
    {
      "type": "project",
      "initial": "DRAFT",
      "states": [
        "DRAFT",
        "ACTIVE",
        "CLOSED"
      ],
      "transitionCount": 5
    },
    {
      "type": "queue",
      "initial": "DRAFT",
      "states": [
        "DRAFT",
        "NESTING",
        "READY",
        "CUT",
        "CLOSED"
      ],
      "transitionCount": 10
    },
    {
      "type": "nesting_run",
      "initial": "NESTING",
      "states": [
        "NESTING",
        "COMPLETE",
        "ERROR",
        "CHOSEN",
        "REJECTED"
      ],
      "transitionCount": 8
    },
    {
      "type": "cassette",
      "initial": "ACTIVE",
      "states": [
        "ACTIVE",
        "ARCHIVED"
      ],
      "transitionCount": 1
    },
    {
      "type": "sheet",
      "initial": "AVAILABLE",
      "states": [
        "AVAILABLE",
        "IN-CUTTING",
        "MILLED",
        "SCRAP"
      ],
      "transitionCount": 4
    },
    {
      "type": "cassette_instance",
      "initial": "PRODUCED",
      "states": [
        "PRODUCED",
        "MILLED",
        "INSTALLED"
      ],
      "transitionCount": 2
    },
    {
      "type": "requisition",
      "initial": "DRAFT",
      "states": [
        "DRAFT",
        "SENT",
        "APPROVED",
        "FULFILLED",
        "REJECTED"
      ],
      "transitionCount": 4
    }
  ],
